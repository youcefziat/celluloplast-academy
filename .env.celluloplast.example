# Celluloplast Academy — Docker Compose
# Copier vers .env :  copy .env.example .env
# Ou lancer :         .\scripts\start-docker.ps1  (génère les secrets automatiquement)

# ── Ports hôte (ajuster si conflit, ex. Postgres déjà sur 5432) ──
POSTGRES_HOST_PORT=5432
REDIS_HOST_PORT=6379

# ── Base de données ──
POSTGRES_DB=classroomio
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# ── Auth (OBLIGATOIRE — générer des valeurs aléatoires longues) ──
BETTER_AUTH_SECRET=
PRIVATE_SERVER_KEY=

# ── URLs publiques ──
PUBLIC_IS_SELFHOSTED=true
DASHBOARD_ORIGIN=http://localhost:3082
PUBLIC_SERVER_URL=http://localhost:3081
PRIVATE_SERVER_URL=http://api:3081
TRUSTED_ORIGINS=http://localhost:3082,http://127.0.0.1:3082,http://localhost:3081,http://127.0.0.1:3081

# Dashboard adapter-node body limit in BYTES (not "900M" — parseInt('900M')===900 on adapter-node 2.x)
# Default without this is 512KB → avatar/logo upload 500. 943718400 = 900 MiB.
BODY_SIZE_LIMIT=943718400

# ── Branding Celluloplast ──
PUBLIC_APP_TITLE=Celluloplast Academy
PUBLIC_APP_DESCRIPTION=Plateforme de formation interne Celluloplast

# ── MinIO (stockage fichiers / médias) ──
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_PUBLIC_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY_ID=minioadmin
OBJECT_STORAGE_SECRET_ACCESS_KEY=minioadmin
OBJECT_STORAGE_FORCE_PATH_STYLE=true
OBJECT_STORAGE_MEDIA_PUBLIC_BASE_URL=http://localhost:9000/media

# ── Optionnel ──
# ── Email (local MailHog by default in docker-compose.celluloplast.yaml) ──
# UI: http://localhost:8025  ·  SMTP from containers: mailhog:1025
# Override these to use a real SMTP provider; leave USER/PASSWORD empty for MailHog.
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=Celluloplast Academy <no-reply@celluloplast.local>
UNSPLASH_API_KEY=
OPENAI_API_KEY=
LICENSE_KEY=
SKIP_DB_SETUP=
